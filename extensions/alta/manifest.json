{
    "manifest_version": 3,
    "name": "ELIO · Alta",
    "description": "ალტას პროდუქტების შეგროვება B2B მარაგის სიით და JSON ფაილის მომზადება elivo.ge-ს ადმინისთვის.",
    "version": "1.0.0",
    "minimum_chrome_version": "120",
    "permissions": [
        "scripting",
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "https://alta.ge/*",
        "https://imgstore.alta.ge/*",
        "https://elivo.ge/*",
        "https://www.elivo.ge/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_title": "ELIO · Alta"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'"
    }
}
